# SensusVault Configuration

# LLM Provider Configuration
# Supported providers: openai, openrouter, anthropic, llama_swap
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SITE_URL=https://your-site-url.com
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Local Inference Configuration (llama-swap)
LLAMA_SERVER_URL=http://localhost:8080
LOCAL_MODEL=gemma4-12b

# Database & Storage Configuration
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=vault_embeddings
GRAPH_DB_PATH=vault.db
VAULT_PATH=./vault
INBOX_PATH=./inbox

# Application Configuration
APP_PORT=8080
UI_PORT=8501
ENABLE_HITL=true

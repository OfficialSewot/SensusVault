# --- SensusVault Configuration ---

# Infrastructure
# The port where the FastAPI app will be accessible
APP_PORT=2200
# The port where ChromaDB is running (inside Docker, it's 8000, but we map it)
CHROMA_PORT=2100

# LLM Inference (llama-swap / llama.cpp)
# The URL where your local llama-swap instance is running
LLAMA_SERVER_URL=http://host.docker.internal:[INSERT-LOCAL-PORT]
# Model parameters (optional, but good for consistency)
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_CONTEXT_WINDOW=128000

# Database & Storage
# The local path where your Markdown files are stored
VAULT_PATH=./vault
# The path where the Inbox (raw data) is stored
INBOX_PATH=./inbox
# The name of the ChromaDB collection
CHROMA_COLLECTION_NAME=vault_knowledge

# Agent Settings
# Whether to enable the Human-in-the-Loop action queue
ENABLE_HITL=true
# The path to the SQLite database for the Graph and Action Queue
GRAPH_DB_PATH=./data/graph.sqlite